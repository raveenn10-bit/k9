<!-- Luxury Image Lightbox Modal -->
<div id="image-lightbox-modal" class="fixed inset-0 z-50 modal-backdrop hidden items-center justify-center p-4 sm:p-8">
  <div class="relative max-w-4xl max-h-[90vh] bg-[#0E1015] border border-white/10 rounded-2xl p-2 sm:p-4 shadow-2xl flex flex-col items-center">
    <button id="close-lightbox" aria-label="Close Lightbox" class="absolute -top-4 -right-4 sm:top-4 sm:right-4 z-10 w-10 h-10 rounded-full bg-black/80 border border-white/20 text-white flex items-center justify-center hover:bg-amber-500 hover:text-black transition-colors">
      <i data-lucide="x" class="w-5 h-5"></i>
    </button>
    <div class="overflow-hidden rounded-xl w-full flex items-center justify-center max-h-[75vh]">
      <img id="lightbox-image-target" src="" alt="Enlarged K9 Academy Photo" class="max-h-[75vh] w-auto object-contain rounded-xl">
    </div>
    <p id="lightbox-caption-target" class="text-xs sm:text-sm text-slate-300 font-medium text-center mt-3 px-4"></p>
  </div>
</div>
