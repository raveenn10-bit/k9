<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Ceylon K9 Academy — Smart Training For Happy Dogs' %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Sri Lanka\'s premier dog training academy. 130K+ community, positive balanced methods, certified graduates.' %>">
  
  <!-- OpenGraph / Social Meta -->
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'Ceylon K9 Academy' %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Smart Training For Happy Dogs — Sri Lanka\'s Premier K9 Training Academy' %>">
  <meta property="og:image" content="/media/hero.jpg">
  <meta property="og:type" content="website">

  <!-- Favicon -->
  <link rel="icon" type="image/jpeg" href="/media/logo.jpg">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              black: '#07080A',
              card: '#0E1015',
              cardLight: '#141720',
              gold: '#F59E0B',
              goldLight: '#FCD34D',
              goldDark: '#B45309',
              orange: '#EA580C',
              silver: '#E2E8F0',
              muted: '#94A3B8'
            }
          },
          fontFamily: {
            serif: ['Playfair Display', 'serif'],
            sans: ['Manrope', 'sans-serif'],
            heading: ['Manrope', 'sans-serif'],
            body: ['DM Sans', 'sans-serif']
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- GSAP & ScrollTrigger -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

  <!-- Instant Theme Script (Zero Flash) -->
  <script>
    if (localStorage.getItem('k9_theme') === 'light') {
      document.documentElement.classList.add('light-mode');
    }
  </script>

  <!-- Custom Master Styles -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[#07080A] text-slate-100 antialiased selection:bg-amber-500 selection:text-black">
