<!-- Luxury Minimalist Editorial Footer (Matches Reference Screenshot Exactly) -->
<footer class="relative bg-[#07080A] border-t border-white/10 pt-20 pb-14 overflow-hidden text-center">
  
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 relative z-10">
    
    <!-- 1. Centered Brand Name with Floating Accent Dot -->
    <div class="inline-block relative">
      <!-- Floating Accent Dot on Left Top -->
      <div class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-md shadow-amber-400/50 absolute -top-2 -left-4 sm:-left-6"></div>
      
      <h2 class="text-3xl sm:text-5xl font-serif text-white tracking-[0.35em] uppercase font-normal">
        CEYLON K9
      </h2>
      <p class="text-[9px] sm:text-[10px] font-sans tracking-[0.3em] text-slate-400 uppercase mt-1">
        ACADEMY
      </p>
    </div>

    <!-- 2. Centered Clean Social Icons -->
    <div class="flex items-center justify-center gap-5 pt-1">
      <a href="<%= data.brand.socials.facebook %>" target="_blank" aria-label="Facebook" class="text-slate-300 hover:text-white hover:scale-110 transition-all p-1">
        <i data-lucide="facebook" class="w-4 h-4 sm:w-5 sm:h-5"></i>
      </a>
      <a href="<%= data.brand.socials.tiktok %>" target="_blank" aria-label="TikTok" class="text-slate-300 hover:text-white hover:scale-110 transition-all p-1">
        <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 24 24">
          <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.86 4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-.04-4.52z"/>
        </svg>
      </a>
      <a href="https://wa.me/<%= data.brand.whatsapp %>" target="_blank" aria-label="WhatsApp" class="text-slate-300 hover:text-green-400 hover:scale-110 transition-all p-1">
        <i data-lucide="message-circle" class="w-4 h-4 sm:w-5 sm:h-5"></i>
      </a>
      <a href="<%= data.brand.socials.instagram %>" target="_blank" aria-label="Instagram" class="text-slate-300 hover:text-white hover:scale-110 transition-all p-1">
        <i data-lucide="instagram" class="w-4 h-4 sm:w-5 sm:h-5"></i>
      </a>
    </div>

    <!-- 3. Centered Main Navigation Links (Matches Screenshot: HOME ALBUMS ABOUT US PLANS TESTIMONIALS) -->
    <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-[11px] sm:text-xs font-semibold tracking-[0.2em] uppercase font-sans text-slate-300 pt-2">
      <a href="index.html" class="hover:text-white transition-colors">HOME</a>
      <a href="index.html#portfolio-section" class="hover:text-white transition-colors">ALBUMS</a>
      <a href="about.html" class="hover:text-white transition-colors">ABOUT US</a>
      <a href="index.html#pricing-section" class="hover:text-white transition-colors">PLANS</a>
      <a href="index.html#testimonials-section" class="hover:text-white transition-colors">TESTIMONIALS</a>
      <a href="programs.html" class="hover:text-white transition-colors">SERVICES</a>
      <a href="equipment.html" class="hover:text-white transition-colors">STORE</a>
    </div>

    <!-- 4. Centered Secondary Services Line (Separated by Bullets •) -->
    <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-[10px] sm:text-xs text-slate-400 font-body">
      <span>Puppy Foundation</span>
      <span class="text-slate-600">•</span>
      <span>Master Obedience</span>
      <span class="text-slate-600">•</span>
      <span>Behavior Modification</span>
      <span class="text-slate-600">•</span>
      <span>Personal Protection K9</span>
      <span class="text-slate-600">•</span>
      <span>VIP Board & Train</span>
      <span class="text-slate-600">•</span>
      <span>In-Home Coaching</span>
    </div>

    <!-- 5. Centered "GET IN TOUCH!" + Large Hotline + Location (Matches Screenshot) -->
    <div class="pt-6 space-y-2.5">
      <span class="text-[10px] font-bold uppercase tracking-[0.25em] text-amber-500 font-sans block">
        GET IN TOUCH!
      </span>
      
      <a href="tel:<%= data.brand.phone %>" class="text-2xl sm:text-3xl lg:text-4xl font-bold font-heading text-white hover:text-amber-400 transition-colors inline-block tracking-wider">
        <%= data.brand.phoneDisplay %>
      </a>

      <p class="text-xs sm:text-sm text-slate-400 font-body flex items-center justify-center gap-1.5 pt-1">
        <i data-lucide="map-pin" class="w-3.5 h-3.5 text-amber-500 shrink-0"></i>
        <span>Address: Western Province & Island-wide, Sri Lanka</span>
      </p>
    </div>

    <!-- 6. Bottom Copyright & Admin Hint Line with Top Border -->
    <div class="border-t border-white/10 pt-8 mt-12 text-[10px] sm:text-xs text-slate-500 font-body flex flex-col sm:flex-row items-center justify-between gap-3">
      <p>Copyright © <%= new Date().getFullYear() %> Ceylon K9 Academy. All Rights Reserved.</p>
      <span class="text-[10px] text-slate-600 flex items-center gap-1">
        <span>Smart Training For Happy Dogs</span>
      </span>
    </div>

  </div>
</footer>

<!-- Partial Components -->
<%- include('./booking-modal') %>
<%- include('./whatsapp-widget') %>
<%- include('./lightbox') %>

<!-- Main JavaScript Execution -->
<script src="/js/main.js"></script>
</body>
</html>
