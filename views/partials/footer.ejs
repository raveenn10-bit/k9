<!-- Luxury Architectural Footer -->
<footer class="relative bg-[#050608] border-t border-white/10 pt-20 pb-12 overflow-hidden">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-32 bg-amber-500/5 blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 mb-16">
      
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2 space-y-6">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full overflow-hidden border border-amber-500/40 p-0.5 bg-black">
            <img src="/media/logo.jpg" alt="Ceylon K9 Academy Logo" class="w-full h-full object-cover rounded-full">
          </div>
          <div>
            <span class="font-heading font-extrabold text-xl text-white tracking-wider">CEYLON K9 ACADEMY</span>
            <p class="text-xs text-amber-400 font-semibold uppercase tracking-widest">Smart Training For Happy Dogs</p>
          </div>
        </div>
        
        <p class="text-slate-400 text-sm leading-relaxed max-w-md">
          Sri Lanka's premier canine education institution. We fuse modern behavioral science, drive dynamics, and compassionate leadership to build balanced, joyful, and impeccably obedient companions.
        </p>

        <!-- Social Channels Matching Exact Reference Image Icons -->
        <div class="pt-2">
          <div class="flex items-center gap-2 mb-3">
            <span class="pulse-dot"></span>
            <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Connect & Follow Us</span>
          </div>
          
          <!-- Exact 4 Square Social Media Buttons (+ TikTok) -->
          <div class="flex flex-wrap items-center gap-2.5">
            
            <!-- 1. Twitter / X (Sky Blue Square) -->
            <a href="<%= data.brand.socials.twitter %>" target="_blank" aria-label="Twitter" title="Twitter / X" class="w-11 h-11 rounded-xl bg-[#1DA1F2] flex items-center justify-center text-white shadow-md hover:scale-110 hover:shadow-sky-500/40 transition-all duration-300">
              <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24">
                <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
              </svg>
            </a>

            <!-- 2. Facebook (Royal Blue Square) -->
            <a href="<%= data.brand.socials.facebook %>" target="_blank" aria-label="Facebook" title="Facebook" class="w-11 h-11 rounded-xl bg-[#4267B2] flex items-center justify-center text-white shadow-md hover:scale-110 hover:shadow-blue-600/40 transition-all duration-300">
              <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>

            <!-- 3. Instagram (Black Square with White Camera Outline) -->
            <a href="<%= data.brand.socials.instagram %>" target="_blank" aria-label="Instagram" title="Instagram" class="w-11 h-11 rounded-xl bg-black border border-white/20 flex items-center justify-center text-white shadow-md hover:scale-110 hover:border-amber-400 hover:shadow-amber-500/30 transition-all duration-300">
              <svg class="w-5 h-5 stroke-white fill-none stroke-2" viewBox="0 0 24 24">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>

            <!-- 4. WhatsApp (Green Square) -->
            <a href="https://wa.me/<%= data.brand.whatsapp %>" target="_blank" aria-label="WhatsApp" title="WhatsApp Concierge" class="w-11 h-11 rounded-xl bg-[#25D366] flex items-center justify-center text-white shadow-md hover:scale-110 hover:shadow-green-500/40 transition-all duration-300">
              <svg class="w-5 h-5 fill-white" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
            </a>

            <!-- 5. TikTok (Dark Carbon with Gradient Border) -->
            <a href="<%= data.brand.socials.tiktok %>" target="_blank" aria-label="TikTok" title="TikTok (@www.ashen8)" class="w-11 h-11 rounded-xl bg-[#111319] border border-white/20 flex items-center justify-center text-white shadow-md hover:scale-110 hover:border-amber-400 transition-all duration-300">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.86 4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-.04-4.52z"/>
              </svg>
            </a>

          </div>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-4">
        <h4 class="font-heading font-bold text-white text-sm uppercase tracking-widest">Training Pathways</h4>
        <ul class="space-y-2.5 text-sm text-slate-400">
          <li><a href="/programs/puppy-foundation" class="hover:text-amber-400 transition-colors">Puppy Foundation</a></li>
          <li><a href="/programs/master-obedience" class="hover:text-amber-400 transition-colors">Master Obedience</a></li>
          <li><a href="/programs/behavior-rehab" class="hover:text-amber-400 transition-colors">Behavior Modification</a></li>
          <li><a href="/programs/vip-residence-bootcamp" class="hover:text-amber-400 transition-colors">VIP Board & Train</a></li>
          <li><a href="/programs/personal-protection" class="hover:text-amber-400 transition-colors">Executive Protection</a></li>
          <li><a href="/programs/in-home-coaching" class="hover:text-amber-400 transition-colors">In-Home Coaching</a></li>
        </ul>
      </div>

      <!-- Academy & Gear -->
      <div class="space-y-4">
        <h4 class="font-heading font-bold text-white text-sm uppercase tracking-widest">Explore Academy</h4>
        <ul class="space-y-2.5 text-sm text-slate-400">
          <li><a href="/gallery" class="hover:text-amber-400 transition-colors">Graduates Hall of Fame</a></li>
          <li><a href="/equipment" class="hover:text-amber-400 transition-colors">Tactical K9 Gear</a></li>
          <li><a href="/about" class="hover:text-amber-400 transition-colors">Training Methodology</a></li>
          <li><a href="/contact" class="hover:text-amber-400 transition-colors">Location & Hours</a></li>
          <li><a href="/contact" class="hover:text-amber-400 transition-colors">Free Evaluation</a></li>
        </ul>
      </div>

      <!-- Direct Concierge Contact -->
      <div class="space-y-4">
        <h4 class="font-heading font-bold text-white text-sm uppercase tracking-widest">Concierge & Bookings</h4>
        <div class="space-y-3 text-sm text-slate-400">
          <div class="flex items-start gap-2.5">
            <i data-lucide="phone" class="w-4 h-4 text-amber-400 shrink-0 mt-1"></i>
            <div>
              <a href="tel:<%= data.brand.phone %>" class="text-white font-medium hover:text-amber-400"><%= data.brand.phone %></a>
              <p class="text-xs text-slate-500">Direct Hotline</p>
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <i data-lucide="mail" class="w-4 h-4 text-amber-400 shrink-0 mt-1"></i>
            <div>
              <a href="mailto:<%= data.brand.email %>" class="text-white font-medium hover:text-amber-400 break-all"><%= data.brand.email %></a>
              <p class="text-xs text-slate-500">Official Inquiries</p>
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <i data-lucide="message-circle" class="w-4 h-4 text-green-400 shrink-0 mt-1"></i>
            <div>
              <a href="https://wa.me/<%= data.brand.whatsapp %>" target="_blank" class="text-green-400 font-medium hover:underline"><%= data.brand.phoneDisplay %></a>
              <p class="text-xs text-slate-500">WhatsApp 24/7</p>
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <i data-lucide="map-pin" class="w-4 h-4 text-amber-400 shrink-0 mt-1"></i>
            <div>
              <p class="text-white font-medium"><%= data.brand.location %></p>
              <p class="text-xs text-slate-500">Island-wide Service</p>
            </div>
          </div>
        </div>

        <button data-open-booking class="btn-primary-luxury text-xs py-2 px-4 w-full justify-center mt-2">
          <span>Book Consultation</span>
          <div class="icon-disc !w-5 !h-5">
            <i data-lucide="arrow-up-right" class="w-3 h-3 text-black"></i>
          </div>
        </button>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/5 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© <%= new Date().getFullYear() %> Ceylon K9 Academy. All rights reserved. Sri Lanka.</p>
      <div class="flex items-center gap-6">
        <span class="text-slate-400">Smart Training For Happy Dogs</span>
        <span class="text-slate-600">|</span>
        <span class="text-amber-400/90 font-medium">Colombo • Kandy • Galle • Island-wide</span>
      </div>
    </div>
  </div>
</footer>

<!-- Partial Components -->
<%- include('./booking-modal') %>
<%- include('./whatsapp-widget') %>
<%- include('./lightbox') %>

<!-- Main JavaScript Execution -->
<script src="/js/main.js"></script>
</body>
</html>
