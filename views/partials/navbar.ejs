<!-- Luxury Editorial Horizontal Navigation Bar (Matches Uploaded Reference Design) -->
<header class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-8 lg:px-12 pt-5 pb-3">
  <nav id="main-navbar" class="max-w-7xl mx-auto flex items-center justify-between py-2.5 px-4 sm:px-6 rounded-full transition-all duration-300">
    
    <!-- Left / Center: Navigation Links in Clean Spaced Uppercase -->
    <div class="hidden lg:flex items-center gap-8 xl:gap-10 text-[11px] xl:text-xs font-semibold tracking-[0.2em] uppercase font-sans text-slate-300">
      <a href="/" class="hover:text-white transition-colors <%= currentPath === '/' ? 'text-white font-bold' : 'text-slate-300' %>">
        HOME
      </a>
      <a href="/#portfolio-section" class="hover:text-white transition-colors">
        ALBUMS
      </a>
      <a href="/about" class="hover:text-white transition-colors <%= currentPath === '/about' ? 'text-white font-bold' : 'text-slate-300' %>">
        ABOUT
      </a>
      <a href="/programs" class="hover:text-white transition-colors <%= currentPath.startsWith('/programs') ? 'text-white font-bold' : 'text-slate-300' %>">
        SERVICES
      </a>
      <a href="/#testimonials-section" class="hover:text-white transition-colors">
        TESTIMONIALS
      </a>
      <a href="/#pricing-section" class="hover:text-white transition-colors">
        PLANS
      </a>
      <a href="/equipment" class="hover:text-white transition-colors <%= currentPath === '/equipment' ? 'text-white font-bold' : 'text-slate-300' %>">
        STORE
      </a>
    </div>

    <!-- Mobile Left Brand -->
    <a href="/" class="flex lg:hidden items-center gap-3">
      <img src="/media/logo.jpg" alt="Ceylon K9 Logo" class="w-8 h-8 rounded-full border border-amber-500/40 object-cover">
      <span class="font-heading font-extrabold text-sm text-white tracking-wider">CEYLON K9</span>
    </a>

    <!-- Right Side: Social Icons & LET'S TALK ↗ Pill Button (Matches Reference) -->
    <div class="flex items-center gap-3.5 sm:gap-4">
      
      <!-- Theme Switcher (Dark / Silver Light) -->
      <button id="theme-toggle-btn" aria-label="Toggle Theme" title="Toggle Dark/Silver Light Mode" class="p-1.5 text-slate-400 hover:text-amber-400 transition-colors">
        <i data-lucide="sun" class="w-4 h-4 theme-icon-sun"></i>
        <i data-lucide="moon" class="w-4 h-4 theme-icon-moon hidden"></i>
      </button>

      <!-- Small Social Icons (Facebook & TikTok/Instagram as in reference) -->
      <a href="<%= data.socials.facebook %>" target="_blank" aria-label="Facebook" class="text-slate-300 hover:text-white transition-colors p-1 hidden sm:inline-flex">
        <i data-lucide="facebook" class="w-4 h-4"></i>
      </a>
      <a href="<%= data.socials.tiktok %>" target="_blank" aria-label="TikTok" class="text-slate-300 hover:text-white transition-colors p-1 hidden sm:inline-flex">
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.86 4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-.04-4.52z"/>
        </svg>
      </a>
      <a href="https://wa.me/<%= data.brand.whatsapp %>" target="_blank" aria-label="WhatsApp" class="text-slate-300 hover:text-green-400 transition-colors p-1 hidden sm:inline-flex">
        <i data-lucide="message-circle" class="w-4 h-4"></i>
      </a>

      <!-- LET'S TALK ↗ Pill Button (Matches Screenshot Exactly) -->
      <button data-open-booking class="px-5 sm:px-6 py-2 sm:py-2.5 rounded-full bg-black text-white border border-white/20 hover:border-amber-400 hover:bg-amber-500 hover:text-black transition-all duration-300 text-[11px] sm:text-xs font-bold uppercase tracking-wider flex items-center gap-1.5 shadow-lg group cursor-pointer">
        <span>LET'S TALK</span>
        <i data-lucide="arrow-up-right" class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform"></i>
      </button>

      <!-- Mobile Hamburger Toggle -->
      <button id="mobile-menu-btn" aria-label="Toggle Navigation Menu" class="lg:hidden p-2 rounded-full bg-white/5 border border-white/10 text-white hover:bg-white/10">
        <i data-lucide="menu" class="w-5 h-5"></i>
      </button>
    </div>

  </nav>
</header>

<!-- Mobile Navigation Drawer Overlay -->
<div id="mobile-menu-overlay" class="fixed inset-0 z-50 modal-backdrop hidden flex-col justify-between p-6">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <img src="/media/logo.jpg" alt="Logo" class="w-9 h-9 rounded-full border border-amber-500/40">
      <span class="font-heading font-extrabold text-white text-base">CEYLON K9 ACADEMY</span>
    </div>
    <div class="flex items-center gap-2">
      <button id="theme-toggle-btn-drawer" aria-label="Toggle Theme" class="p-2 rounded-full bg-white/10 text-amber-400">
        <i data-lucide="sun" class="w-4 h-4 theme-icon-sun"></i>
        <i data-lucide="moon" class="w-4 h-4 theme-icon-moon hidden"></i>
      </button>
      <button id="mobile-menu-close" class="p-2 rounded-full bg-white/10 text-white hover:bg-white/20">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>
  </div>

  <div class="flex flex-col gap-5 text-center my-auto py-6">
    <a href="/" class="text-xl font-heading font-bold text-white hover:text-amber-400 transition-colors">Home</a>
    <a href="/programs" class="text-xl font-heading font-bold text-white hover:text-amber-400 transition-colors">Training Programs</a>
    <a href="/gallery" class="text-xl font-heading font-bold text-white hover:text-amber-400 transition-colors">Graduates & Gallery</a>
    <a href="/equipment" class="text-xl font-heading font-bold text-white hover:text-amber-400 transition-colors">K9 Gear & Products</a>
    <a href="/about" class="text-xl font-heading font-bold text-white hover:text-amber-400 transition-colors">About Academy</a>
    <a href="/contact" class="text-xl font-heading font-bold text-white hover:text-amber-400 transition-colors">Contact & Booking</a>
  </div>

  <div class="flex flex-col gap-3">
    <button data-open-booking onclick="document.getElementById('mobile-menu-overlay').classList.add('hidden')" class="btn-primary-luxury justify-center w-full">
      <i data-lucide="calendar" class="w-4 h-4 text-black"></i>
      <span>Book Evaluation</span>
    </button>
    <a href="https://wa.me/<%= data.brand.whatsapp %>?text=<%= encodeURIComponent(data.brand.whatsappDefaultMsg) %>" target="_blank" class="btn-whatsapp-luxury justify-center w-full">
      <i data-lucide="message-circle" class="w-4 h-4 text-white"></i>
      <span>WhatsApp Concierge</span>
    </a>
  </div>
</div>
