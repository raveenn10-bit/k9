<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="relative pt-28 sm:pt-36 pb-20 bg-mesh-radial bg-noise">
  
  <!-- About Hero -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <div class="lg:col-span-6 space-y-6">
        <div class="eyebrow-badge">
          <i data-lucide="award" class="w-3.5 h-3.5"></i>
          <span>The Ceylon K9 Philosophy</span>
        </div>
        
        <h1 class="text-4xl sm:text-6xl font-extrabold font-heading text-white leading-tight">
          Smart Training <br><span class="gold-gradient-text">For Happy Dogs</span>
        </h1>

        <p class="text-slate-300 text-base leading-relaxed">
          Founded with a singular mission: to eliminate the outdated, force-only dog training practices of the past and replace them with compassionate, modern canine ethology, marker training, and drive-channeling science.
        </p>

        <p class="text-slate-400 text-sm leading-relaxed">
          With an active community of over 130,000 canine lovers and more than 2,500 successfully certified graduates across Sri Lanka, Ceylon K9 Academy stands as the premier authority in canine education, puppy foundation, and complex behavioral rehabilitation.
        </p>

        <div class="pt-2 flex flex-wrap gap-4">
          <div class="p-4 rounded-2xl bg-black/40 border border-white/10 text-center min-w-[120px]">
            <span class="text-3xl font-extrabold text-amber-400 font-heading block">130K+</span>
            <span class="text-xs text-slate-400">Social Followers</span>
          </div>
          <div class="p-4 rounded-2xl bg-black/40 border border-white/10 text-center min-w-[120px]">
            <span class="text-3xl font-extrabold text-amber-400 font-heading block">2,500+</span>
            <span class="text-xs text-slate-400">Graduates Certified</span>
          </div>
          <div class="p-4 rounded-2xl bg-black/40 border border-white/10 text-center min-w-[120px]">
            <span class="text-3xl font-extrabold text-amber-400 font-heading block">99.4%</span>
            <span class="text-xs text-slate-400">Owner Satisfaction</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="hero-banner-frame">
          <img src="/media/hero.jpg" alt="Ceylon K9 Academy Banner" class="w-full object-cover">
        </div>
      </div>

    </div>
  </section>

  <!-- Core Pillars -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <span class="eyebrow-badge">Our Scientific Standard</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-white">
        Why Ceylon K9 Academy is Different
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="c-bezel">
        <div class="c-bezel-inner p-8 space-y-4">
          <div class="w-12 h-12 rounded-full bg-amber-500/10 text-amber-400 flex items-center justify-center">
            <i data-lucide="brain" class="w-6 h-6"></i>
          </div>
          <h3 class="text-xl font-bold font-heading text-white">Canine Psychology First</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            We don't suppress symptoms; we identify root neuro-behavioral causes. Whether it is fear-based reactivity or pent-up prey drive, we speak your dog's language.
          </p>
        </div>
      </div>

      <div class="c-bezel">
        <div class="c-bezel-inner p-8 space-y-4">
          <div class="w-12 h-12 rounded-full bg-amber-500/10 text-amber-400 flex items-center justify-center">
            <i data-lucide="users" class="w-6 h-6"></i>
          </div>
          <h3 class="text-xl font-bold font-heading text-white">Family & Handler Coaching</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            A dog is only as good as the handler's consistency. We empower you, your children, and your domestic staff with exact voice modulation, body positioning, and timing.
          </p>
        </div>
      </div>

      <div class="c-bezel">
        <div class="c-bezel-inner p-8 space-y-4">
          <div class="w-12 h-12 rounded-full bg-amber-500/10 text-amber-400 flex items-center justify-center">
            <i data-lucide="shield-check" class="w-6 h-6"></i>
          </div>
          <h3 class="text-xl font-bold font-heading text-white">Lifetime Support Guarantee</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Graduation isn't the end of our relationship. Every Ceylon K9 Academy alumnus receives ongoing guidance and advice for any new milestones throughout your canine's life.
          </p>
        </div>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
