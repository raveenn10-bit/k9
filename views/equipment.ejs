<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="relative pt-28 sm:pt-36 pb-20 bg-mesh-radial bg-noise">
  
  <!-- Header -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
    <div class="max-w-3xl mx-auto space-y-4">
      <div class="eyebrow-badge">
        <i data-lucide="shield" class="w-3.5 h-3.5"></i>
        <span>Professional Grade Hardware</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold font-heading text-white">
        Ceylon K9 Elite <br><span class="gold-gradient-text">Tactical Gear & Equipment</span>
      </h1>
      <p class="text-slate-400 text-base sm:text-lg">
        Heavy-duty harnesses, BioThane leashes, German Herm Sprenger collars, and training toys designed for serious handlers and loving dog owners in Sri Lanka.
      </p>
    </div>
  </section>

  <!-- Products Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% products.forEach(function(prod) { %>
        <div class="c-bezel reveal-card">
          <div class="c-bezel-inner p-6 flex flex-col justify-between h-full">
            
            <div>
              <div class="relative h-64 rounded-2xl overflow-hidden mb-5 border border-white/10 group cursor-pointer" data-lightbox data-lightbox-src="<%= prod.image %>" data-lightbox-caption="<%= prod.name %> - <%= prod.price %>">
                <img src="<%= prod.image %>" alt="<%= prod.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                
                <div class="absolute top-3 left-3">
                  <span class="px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/10 text-slate-300 text-xs font-bold uppercase">
                    <%= prod.category %>
                  </span>
                </div>

                <div class="absolute top-3 right-3 p-2 rounded-full bg-black/80 text-white border border-white/20 opacity-0 group-hover:opacity-100 transition-opacity">
                  <i data-lucide="maximize-2" class="w-4 h-4"></i>
                </div>

                <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-xs">
                  <span class="text-amber-400 font-bold">★ <%= prod.rating %> (<%= prod.reviewsCount %> reviews)</span>
                  <span class="text-green-400 font-semibold bg-green-500/20 px-2 py-0.5 rounded">In Stock (Island-wide)</span>
                </div>
              </div>

              <h3 class="text-xl font-bold font-heading text-white mb-2"><%= prod.name %></h3>
              <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-4">
                <%= prod.description %>
              </p>

              <div class="space-y-2 mb-6">
                <% prod.features.forEach(function(feat) { %>
                  <div class="flex items-center gap-2 text-xs text-slate-300">
                    <i data-lucide="check-circle" class="w-3.5 h-3.5 text-amber-400 shrink-0"></i>
                    <span><%= feat %></span>
                  </div>
                <% }); %>
              </div>
            </div>

            <div class="pt-4 border-t border-white/5 flex items-center justify-between gap-3">
              <div>
                <span class="text-[10px] uppercase tracking-wider text-slate-500 block">Price</span>
                <span class="text-xl font-extrabold text-amber-400 font-heading"><%= prod.price %></span>
              </div>
              
              <a href="https://wa.me/<%= data.brand.whatsapp %>?text=<%= encodeURIComponent('Hello Ceylon K9 Academy, I would like to order: ' + prod.name + ' (' + prod.price + ')') %>" target="_blank" class="btn-whatsapp-luxury text-xs py-2.5 px-4">
                <i data-lucide="shopping-bag" class="w-4 h-4"></i>
                <span>Order via WhatsApp</span>
              </a>
            </div>

          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- Delivery & Quality Guarantee Banner -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="c-bezel bg-black/60">
      <div class="c-bezel-inner p-8 sm:p-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
          <div class="space-y-2">
            <div class="w-12 h-12 rounded-full bg-amber-500/10 text-amber-400 flex items-center justify-center mx-auto mb-3">
              <i data-lucide="truck" class="w-6 h-6"></i>
            </div>
            <h4 class="text-base font-bold text-white font-heading">Island-Wide Fast Delivery</h4>
            <p class="text-xs text-slate-400">Cash on Delivery & Bank Transfer available throughout Sri Lanka (Colombo, Kandy, Galle, etc.)</p>
          </div>

          <div class="space-y-2">
            <div class="w-12 h-12 rounded-full bg-amber-500/10 text-amber-400 flex items-center justify-center mx-auto mb-3">
              <i data-lucide="shield-check" class="w-6 h-6"></i>
            </div>
            <h4 class="text-base font-bold text-white font-heading">Trainer Tested & Certified</h4>
            <p class="text-xs text-slate-400">Only professional-grade materials that withstand high-drive canine tension and tropical weather.</p>
          </div>

          <div class="space-y-2">
            <div class="w-12 h-12 rounded-full bg-amber-500/10 text-amber-400 flex items-center justify-center mx-auto mb-3">
              <i data-lucide="headphones" class="w-6 h-6"></i>
            </div>
            <h4 class="text-base font-bold text-white font-heading">Sizing & Fitting Advice</h4>
            <p class="text-xs text-slate-400">Message our Master Trainers for exact breed measurements before purchasing.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
