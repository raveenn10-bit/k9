<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="relative bg-[#07080A] text-slate-100 selection:bg-amber-500 selection:text-black">
  
  <!-- 1. FULL-BLEED EDITORIAL HERO (Matches Reference Header) -->
  <section class="relative min-h-[90vh] lg:min-h-screen flex flex-col justify-end pt-28 pb-16 px-4 sm:px-6 lg:px-8 overflow-hidden">
    
    <!-- Background Hero Image with Deep Luxury Gradient Overlay & Ken Burns Zoom -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <img src="/media/hero.jpg" alt="Ceylon K9 Academy — Master Trainer Ashen" class="w-full h-full object-cover object-[70%_center] sm:object-[75%_center] kenburns-hero transform" fetchpriority="high" decoding="async">
      <div class="hero-overlay-horizontal absolute inset-0 sm:w-3/4"></div>
      <div class="hero-overlay-vertical absolute inset-0"></div>
    </div>

    <!-- Hero Content Overlay with Staggered Fade-Up Reveal -->
    <div class="relative z-10 max-w-7xl mx-auto w-full space-y-6">
      
      <!-- Main Headline (Exact Editorial Hierarchy) -->
      <div class="hero-stagger max-w-4xl space-y-3">
        <h1 class="text-4xl sm:text-7xl lg:text-8xl font-serif tracking-[0.25em] leading-[1.08] text-white uppercase font-normal">
          SMART TRAINING <br>
          <span class="gold-gradient-text">FOR HAPPY DOGS</span>
        </h1>
        <p class="text-xs sm:text-base text-slate-300 font-normal font-body max-w-2xl leading-relaxed">
          Transforming canine behavior through ethology-based positive reinforcement, handler mastery, and proven real-world distraction proofing across Sri Lanka.
        </p>
      </div>

      <!-- Hero Action (Clean Luxury Primary CTA) -->
      <div class="hero-stagger pt-3 flex items-center gap-4">
        <button data-open-booking class="btn-primary-luxury justify-center font-sans text-xs uppercase tracking-wider">
          <span>Book Training Evaluation</span>
          <div class="icon-disc">
            <i data-lucide="arrow-up-right" class="w-3.5 h-3.5 text-black"></i>
          </div>
        </button>
      </div>

    </div>
  </section>

  <!-- 2. ABOUT & CAPABILITIES (Matches Screenshot Exactly: Left Portrait + Right 2x3 Capsules + Bio + More Button) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 border-t border-white/5">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Floating Dot + Portrait Card (Properly Centered) -->
      <div class="lg:col-span-5 flex flex-col items-center lg:items-start">
        
        <!-- Floating Accent Dot -->
        <div class="w-3.5 h-3.5 rounded-full bg-amber-400 shadow-lg shadow-amber-400/50 mb-6 hidden lg:block"></div>

        <!-- Master Trainer Portrait Card (Centered and Scaled to Fill Frame Perfectly) -->
        <div class="relative w-full max-w-md mx-auto lg:max-w-none aspect-[3/4] sm:aspect-[4/5] rounded-[2rem] overflow-hidden bg-gradient-to-b from-[#181C26] via-[#0E1015] to-[#07080A] border border-white/10 shadow-2xl group flex items-center justify-center p-4 sm:p-6">
          <img src="/media/ashen-portrait.png" alt="Master Trainer Ashen — Ceylon K9 Academy" class="w-full h-full object-contain object-center scale-115 sm:scale-125 group-hover:scale-130 transition-transform duration-700">
          
          <!-- Bottom Floating Badge -->
          <div class="absolute bottom-4 left-4 right-4 p-3 rounded-2xl bg-black/85 backdrop-blur-md border border-white/10 flex items-center justify-between z-10 shadow-lg">
            <div>
              <h4 class="text-xs font-bold font-heading text-white">Master Trainer Ashen</h4>
              <p class="text-[10px] text-amber-400 font-medium">Founder & Head Canine Ethologist</p>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/30 text-[9px] font-bold uppercase tracking-wider">
              10+ Yrs Exp
            </span>
          </div>
        </div>

      </div>

      <!-- Right Column: Title + Address + 2x3 Grid Capsules + Narrative Copy + More Button -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Header & Location (Matches Reference Screenshot) -->
        <div class="space-y-2">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-heading text-white tracking-wide uppercase">
            CEYLON K9 ACADEMY
          </h2>
          <div class="flex items-center gap-1.5 text-xs font-bold text-amber-500 uppercase tracking-widest">
            <svg class="w-3.5 h-3.5 fill-current text-amber-400 shrink-0" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/>
            </svg>
            <span>LOCATION: WESTERN PROVINCE & ISLAND-WIDE, SRI LANKA</span>
          </div>
        </div>

        <!-- 2x3 Capability / Discipline Capsules Grid (With Guaranteed Crisp Icons & Emojis) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2">
          
          <!-- Capsule 1: Puppy Foundation -->
          <div class="p-3.5 rounded-2xl bg-[#0E1015] border border-white/10 hover:border-amber-500/40 transition-all flex items-center gap-3.5 group cursor-pointer" onclick="window.location.href='programs.html#puppy-foundation'">
            <div class="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center shrink-0 text-base group-hover:bg-amber-500 group-hover:text-black transition-all shadow-md">
              <span>✨</span>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white group-hover:text-amber-400 transition-colors">Puppy Foundation</h4>
              <p class="text-[11px] text-slate-400">Early Imprinting & House Manners</p>
            </div>
          </div>

          <!-- Capsule 2: Master Obedience -->
          <div class="p-3.5 rounded-2xl bg-[#0E1015] border border-white/10 hover:border-amber-500/40 transition-all flex items-center gap-3.5 group cursor-pointer" onclick="window.location.href='programs.html#master-obedience'">
            <div class="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center shrink-0 text-base group-hover:bg-amber-500 group-hover:text-black transition-all shadow-md">
              <span>🛡️</span>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white group-hover:text-amber-400 transition-colors">Master Obedience</h4>
              <p class="text-[11px] text-slate-400">Loose Leash & Distance Recall</p>
            </div>
          </div>

          <!-- Capsule 3: Behavior Modification -->
          <div class="p-3.5 rounded-2xl bg-[#0E1015] border border-white/10 hover:border-amber-500/40 transition-all flex items-center gap-3.5 group cursor-pointer" onclick="window.location.href='programs.html#behavior-rehab'">
            <div class="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center shrink-0 text-base group-hover:bg-amber-500 group-hover:text-black transition-all shadow-md">
              <span>🧠</span>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white group-hover:text-amber-400 transition-colors">Behavior Modification</h4>
              <p class="text-[11px] text-slate-400">Reactivity & Trauma Rehab</p>
            </div>
          </div>

          <!-- Capsule 4: Personal Protection -->
          <div class="p-3.5 rounded-2xl bg-[#0E1015] border border-white/10 hover:border-amber-500/40 transition-all flex items-center gap-3.5 group cursor-pointer" onclick="window.location.href='programs.html#personal-protection'">
            <div class="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center shrink-0 text-base group-hover:bg-amber-500 group-hover:text-black transition-all shadow-md">
              <span>⚡</span>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white group-hover:text-amber-400 transition-colors">Personal Protection</h4>
              <p class="text-[11px] text-slate-400">Executive & Working K9 Guard</p>
            </div>
          </div>

          <!-- Capsule 5: VIP Board & Train -->
          <div class="p-3.5 rounded-2xl bg-[#0E1015] border border-white/10 hover:border-amber-500/40 transition-all flex items-center gap-3.5 group cursor-pointer" onclick="window.location.href='programs.html#vip-residence-bootcamp'">
            <div class="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center shrink-0 text-base group-hover:bg-amber-500 group-hover:text-black transition-all shadow-md">
              <span>🏡</span>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white group-hover:text-amber-400 transition-colors">VIP Board & Train</h4>
              <p class="text-[11px] text-slate-400">In-Residence Master Bootcamp</p>
            </div>
          </div>

          <!-- Capsule 6: In-Home Mentorship -->
          <div class="p-3.5 rounded-2xl bg-[#0E1015] border border-white/10 hover:border-amber-500/40 transition-all flex items-center gap-3.5 group cursor-pointer" onclick="window.location.href='programs.html#in-home-coaching'">
            <div class="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center shrink-0 text-base group-hover:bg-amber-500 group-hover:text-black transition-all shadow-md">
              <span>🤝</span>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white group-hover:text-amber-400 transition-colors">In-Home Coaching</h4>
              <p class="text-[11px] text-slate-400">Family & Handler Mentorship</p>
            </div>
          </div>

        </div>

        <!-- Bio Paragraphs (Matches Reference Copy Style) -->
        <div class="space-y-3 pt-2 text-slate-300 text-xs sm:text-sm leading-relaxed font-body">
          <p>
            I'm <strong class="text-white">Ashen</strong>, Master Canine Trainer & Ethologist. Based in the Western Province with island-wide programs across Sri Lanka, the trainer in me finds potential in every dog — building calm confidence, off-leash obedience, and harmonious family life.
          </p>
          <p>
            Our approach to canine education across Sri Lanka is deeply personal and scientifically grounded. A program is built upon understanding canine psychology and structured communication, bursting with positive motivation. I transform behavioral challenges into a lifelong bond between you and your dog.
          </p>
        </div>

        <!-- Sleek "MORE" Button (Matches Screenshot Exactly) -->
        <div class="pt-3">
          <a href="/about" class="inline-flex items-center justify-center px-8 py-3 rounded-lg bg-[#1E222D] hover:bg-amber-500 hover:text-black border border-white/10 text-xs font-bold uppercase tracking-widest text-white transition-all shadow-md">
            MORE
          </a>
        </div>

      </div>

    </div>
  </section>

  <!-- 3. ALBUMS (Matches Reference Screenshot Exactly: Spaced Title + Filter Pills + 3x3 Clean Portrait Grid) -->
  <section id="portfolio-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 border-t border-white/5">
    
    <!-- Section Title (Exact Letter-Spaced Serif Heading from Screenshot) -->
    <div class="text-center max-w-3xl mx-auto mb-10 space-y-4">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif text-white tracking-[0.35em] uppercase font-normal">
        A L B U M S
      </h2>

      <!-- Filter Pill Buttons (Matches Screenshot: Centered Pills with "ALL WORKS") -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-2">
        <button class="gallery-filter-btn active px-4 py-1.5 rounded-full bg-black border border-amber-500/60 text-amber-400 text-[10px] sm:text-[11px] font-bold uppercase tracking-widest transition-all shadow-md" data-filter="all">
          ALL WORKS
        </button>
        <button class="gallery-filter-btn px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:border-white/30 text-[10px] sm:text-[11px] font-semibold uppercase tracking-widest transition-all" data-filter="rottweiler">
          ROTTWEILER
        </button>
        <button class="gallery-filter-btn px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:border-white/30 text-[10px] sm:text-[11px] font-semibold uppercase tracking-widest transition-all" data-filter="gsd">
          GERMAN SHEPHERD
        </button>
        <button class="gallery-filter-btn px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:border-white/30 text-[10px] sm:text-[11px] font-semibold uppercase tracking-widest transition-all" data-filter="malinois">
          BELGIAN MALINOIS
        </button>
        <button class="gallery-filter-btn px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:border-white/30 text-[10px] sm:text-[11px] font-semibold uppercase tracking-widest transition-all" data-filter="boxer">
          BOXER & FAMILY
        </button>
        <button class="gallery-filter-btn px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-slate-400 hover:text-white hover:border-white/30 text-[10px] sm:text-[11px] font-semibold uppercase tracking-widest transition-all" data-filter="puppy">
          PUPPIES
        </button>
      </div>
    </div>

    <!-- 3x3 Clean Portrait Grid (Matches Screenshot: 3 Columns, Frameless High-Res Portrait Cards) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      <% data.graduates.forEach(function(grad) { %>
        <div class="gallery-grid-item group relative rounded-xl sm:rounded-2xl overflow-hidden bg-[#0E1015] border border-white/10 hover:border-amber-500/50 transition-all duration-500 cursor-pointer shadow-lg" data-category="<%= grad.category %>" data-lightbox data-lightbox-src="<%= grad.image %>" data-lightbox-caption="<%= grad.name %> (<%= grad.breed %>) — <%= grad.certificate %>">
          
          <!-- Image Aspect Ratio Container -->
          <div class="relative aspect-[3/4] w-full overflow-hidden bg-black">
            <img src="<%= grad.image %>" alt="<%= grad.name %>" class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700">
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/15 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

            <!-- Top Tag on Hover -->
            <div class="absolute top-3.5 left-3.5 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <span class="px-2.5 py-1 rounded-full bg-black/80 backdrop-blur-md border border-amber-500/40 text-amber-400 text-[10px] font-bold uppercase tracking-wider">
                <%= grad.certificate %>
              </span>
            </div>

            <!-- Zoom Icon on Hover -->
            <div class="absolute top-3.5 right-3.5 p-2 rounded-full bg-black/80 text-white border border-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i>
            </div>

            <!-- Subtle Bottom Watermark Tag (Matches Photography Reference Style) -->
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-white/80 opacity-60 group-hover:opacity-100 transition-opacity">
              <div>
                <h4 class="text-xs sm:text-sm font-bold font-heading text-white"><%= grad.name %></h4>
                <p class="text-[10px] text-amber-400/90 font-medium uppercase tracking-wider"><%= grad.breed %></p>
              </div>
              <span class="text-[9px] text-slate-400 uppercase tracking-widest hidden sm:inline">© Ceylon K9</span>
            </div>
          </div>

        </div>
      <% }); %>
    </div>

    <!-- View All Button -->
    <div class="mt-12 text-center">
      <a href="/gallery" class="inline-flex items-center justify-center px-8 py-3 rounded-lg bg-[#1E222D] hover:bg-amber-500 hover:text-black border border-white/10 text-xs font-bold uppercase tracking-widest text-white transition-all shadow-md">
        VIEW FULL GRADUATE ALBUM
      </a>
    </div>
  <!-- 4. TESTIMONIALS (Matches Reference Alternating Staggered Layout) -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 border-t border-white/5">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <h2 class="text-3xl sm:text-5xl font-bold font-brand text-white tracking-widest uppercase">
        TESTIMONIALS
      </h2>
      <p class="text-slate-400 text-sm font-body">Real stories from our graduated canine families across Sri Lanka.</p>
    </div>

    <div class="space-y-16">
      
      <!-- Testimonial Row 1 (Text Left + Photo Right) -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-7 space-y-4">
          <div class="flex text-amber-400 text-sm">★★★★★</div>
          <p class="text-slate-200 text-base sm:text-lg italic font-serif leading-relaxed">
            "Ceylon K9 Academy is miles ahead of traditional dog trainers in Sri Lanka. Their modern, science-based approach made Thor so obedient that he walks beside me through Colombo traffic with zero tension. Truly luxury standard!"
          </p>
          <div>
            <h4 class="text-base font-bold text-white font-heading">Dr. Sanjeewa Wickramasinghe</h4>
            <p class="text-xs text-amber-400 font-medium">Colombo 07 • Thor (German Shepherd)</p>
          </div>
        </div>
        <div class="md:col-span-5">
          <div class="rounded-2xl overflow-hidden border border-white/10 aspect-[4/5] bg-[#0E1015] shadow-2xl group cursor-pointer" data-lightbox data-lightbox-src="/Album/500237257_122131567916787892_3281965166062166311_n.jpg" data-lightbox-caption="Thor (German Shepherd Graduate) with Master Trainer Ashen">
            <img src="/Album/500237257_122131567916787892_3281965166062166311_n.jpg" alt="Thor GSD Graduate" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700">
          </div>
        </div>
      </div>

      <!-- Testimonial Row 2 (Photo Left + Text Right) -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-5 order-2 md:order-1">
          <div class="rounded-2xl overflow-hidden border border-white/10 aspect-[4/5] bg-[#0E1015] shadow-2xl group cursor-pointer" data-lightbox data-lightbox-src="/Album/555549741_122154654404787892_5315441370469195461_n.jpg" data-lightbox-caption="Buri & Bura (Boxer & Dogo Siblings) Obedience Mastery">
            <img src="/Album/555549741_122154654404787892_5315441370469195461_n.jpg" alt="Buri & Bura Boxers" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700">
          </div>
        </div>
        <div class="md:col-span-7 order-1 md:order-2 space-y-4">
          <div class="flex text-amber-400 text-sm">★★★★★</div>
          <p class="text-slate-200 text-base sm:text-lg italic font-serif leading-relaxed">
            "Managing two high-energy Boxers pulling on leashes was a daily struggle. Following the structured obedience program, both now walk in unison side-by-side with loose leashes without chaos. Unbelievable expertise!"
          </p>
          <div>
            <h4 class="text-base font-bold text-white font-heading">Kavinda & Shiroma Perera</h4>
            <p class="text-xs text-amber-400 font-medium">Negombo • Buri & Bura (Boxer Siblings)</p>
          </div>
        </div>
      </div>

      <!-- Testimonial Row 3 (Text Left + Photo Right) -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-7 space-y-4">
          <div class="flex text-amber-400 text-sm">★★★★★</div>
          <p class="text-slate-200 text-base sm:text-lg italic font-serif leading-relaxed">
            "I was worried about Zeus's reactive barking toward strangers. The behavioral team at Ceylon K9 Academy diagnosed the root-cause and rehabilitated him completely. Worth every single rupee."
          </p>
          <div>
            <h4 class="text-base font-bold text-white font-heading">Dinesh Ratnayake</h4>
            <p class="text-xs text-amber-400 font-medium">Mount Lavinia • Zeus (Rottweiler)</p>
          </div>
        </div>
        <div class="md:col-span-5">
          <div class="rounded-2xl overflow-hidden border border-white/10 aspect-[4/5] bg-[#0E1015] shadow-2xl group cursor-pointer" data-lightbox data-lightbox-src="/Album/495901457_122128226996787892_5118561498875172140_n.jpg" data-lightbox-caption="Zeus (Rottweiler Behavioral Rehab Graduate)">
            <img src="/Album/495901457_122128226996787892_5118561498875172140_n.jpg" alt="Zeus Rottweiler" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700">
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 5. PLANS & INVESTMENT (Matches Exact Uploaded Ceylon K9 Academy 10-Day Program & Flexible Pricing) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 border-t border-white/5">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <span class="eyebrow-badge">Transparent Tuition & Official Fees</span>
      <h2 class="text-3xl sm:text-5xl font-bold font-brand text-white tracking-widest uppercase">
        PLANS & INVESTMENT
      </h2>
      <p class="text-slate-400 text-sm sm:text-base font-body">
        Our official 10-day intensive training program designed for rapid, permanent behavioral correction and complete obedience.
      </p>
    </div>

    <!-- 2 Plans Pricing Grid (Matches Screenshot Details) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch max-w-4xl mx-auto">
      
      <!-- Plan 1: 10-Day Continuous Intensive Training Program (Full Package Highlight) -->
      <div class="c-bezel border-amber-500/60 pricing-card-highlight">
        <div class="c-bezel-inner p-8 sm:p-10 flex flex-col justify-between h-full bg-[#07080A] space-y-6">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase text-amber-400 font-bold tracking-wider">Most Popular Choice</span>
              <span class="px-3 py-0.5 rounded-full bg-amber-500 text-black text-[10px] font-extrabold uppercase">Full Package 🚀</span>
            </div>
            
            <h3 class="text-2xl sm:text-3xl font-extrabold font-heading text-white mt-2">
              10-Day Intensive Program
            </h3>
            <p class="text-xs text-slate-400 mt-1">10 Continuous Days • 50 Minutes per day</p>
            
            <!-- Price Display -->
            <div class="my-6 p-4 rounded-2xl bg-amber-500/5 border border-amber-500/20">
              <div class="flex items-baseline gap-2">
                <span class="text-3xl sm:text-4xl font-black text-amber-400 font-heading">Rs. 50,000/=</span>
                <span class="text-xs text-slate-300 font-semibold uppercase">Total Cost</span>
              </div>
              <div class="text-[11px] text-slate-400 mt-1 space-y-0.5">
                <p>• Training Fee (10 Days): <strong class="text-white">Rs. 45,000/=</strong></p>
                <p>• Transportation Fee (All 10 Days): <strong class="text-white">Rs. 5,000/=</strong></p>
              </div>
            </div>

            <!-- Curriculum Checklist (Matches Screenshot Exactly) -->
            <div class="space-y-4 text-xs text-slate-200 border-t border-white/10 pt-4">
              <div>
                <h4 class="font-bold text-amber-400 uppercase text-[11px] mb-2">✔️ Behavior Correction Content:</h4>
                <ul class="space-y-1.5 text-slate-300 pl-2">
                  <li class="flex items-center gap-2">✓ Fix Jumping & Hyperactivity</li>
                  <li class="flex items-center gap-2">✓ Eliminate Leash Pulling & Dragging</li>
                  <li class="flex items-center gap-2">✓ Aggression & Reactivity Remediation</li>
                  <li class="flex items-center gap-2">✓ Stop Excessive Barking & Destructive Habits</li>
                </ul>
