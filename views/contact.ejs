<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="relative pt-28 sm:pt-36 pb-20 bg-mesh-radial bg-noise">
  
  <!-- Header -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 text-center">
    <div class="max-w-3xl mx-auto space-y-4">
      <div class="eyebrow-badge">
        <i data-lucide="phone-call" class="w-3.5 h-3.5"></i>
        <span>Direct Academy Concierge</span>
      </div>
      <h1 class="text-4xl sm:text-6xl font-extrabold font-heading text-white">
        Contact & Book Your <br><span class="gold-gradient-text">Dog Training Evaluation</span>
      </h1>
      <p class="text-slate-400 text-base sm:text-lg">
        Connect with our Master Trainers in Colombo, Sri Lanka. Fast-track your booking via form or instant WhatsApp.
      </p>
    </div>
  </section>

  <!-- Contact & Booking Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Contact Info & Direct Links (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="c-bezel">
          <div class="c-bezel-inner p-8 space-y-6">
            <h3 class="text-2xl font-bold font-heading text-white">Academy Headquarters</h3>
            
            <div class="space-y-4 text-sm text-slate-300">
              
              <!-- TikTok Official -->
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-full bg-white/10 text-white flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                    <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.86 4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-.04-4.52z"/>
                  </svg>
                </div>
                <div>
                  <span class="text-xs uppercase text-slate-500 font-bold block">TikTok Official</span>
                  <a href="<%= academy.brand.socials.tiktok %>" target="_blank" class="text-base font-bold text-white hover:text-amber-400">www.ashen8 • <%= academy.brand.socials.tiktokHandle %></a>
                  <p class="text-xs text-slate-400">Watch live training demonstrations & tips</p>
                </div>
              </div>

              <!-- Phone Hotline -->
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-full bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0">
                  <i data-lucide="phone" class="w-5 h-5"></i>
                </div>
                <div>
                  <span class="text-xs uppercase text-slate-500 font-bold block">Direct Hotline</span>
                  <a href="tel:<%= academy.brand.phone %>" class="text-base font-bold text-white hover:text-amber-400"><%= academy.brand.phone %></a>
                  <p class="text-xs text-slate-400">Available 7:00 AM – 7:00 PM</p>
                </div>
              </div>

              <!-- Official Email -->
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-full bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0">
                  <i data-lucide="mail" class="w-5 h-5"></i>
                </div>
                <div>
                  <span class="text-xs uppercase text-slate-500 font-bold block">Official Email</span>
                  <a href="mailto:<%= academy.brand.email %>" class="text-base font-bold text-amber-400 hover:underline break-all"><%= academy.brand.email %></a>
                  <p class="text-xs text-slate-400">Inquiries & institutional partnerships</p>
                </div>
              </div>

              <!-- WhatsApp -->
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-full bg-green-500/10 text-green-400 flex items-center justify-center shrink-0">
                  <i data-lucide="message-circle" class="w-5 h-5"></i>
                </div>
                <div>
                  <span class="text-xs uppercase text-slate-500 font-bold block">WhatsApp Concierge</span>
                  <a href="https://wa.me/<%= academy.brand.whatsapp %>" target="_blank" class="text-base font-bold text-green-400 hover:underline"><%= academy.brand.phoneDisplay %></a>
                  <p class="text-xs text-slate-400">Instant trainer chat & evaluation booking</p>
                </div>
              </div>

              <!-- Messenger / Facebook -->
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-full bg-blue-500/10 text-blue-400 flex items-center justify-center shrink-0">
                  <i data-lucide="message-square" class="w-5 h-5"></i>
                </div>
                <div>
                  <span class="text-xs uppercase text-slate-500 font-bold block">Facebook & Messenger</span>
                  <a href="<%= academy.brand.socials.messenger %>" target="_blank" class="text-base font-bold text-blue-400 hover:underline">Ceylon K9 Academy</a>
                  <p class="text-xs text-slate-400">Direct message our social team</p>
                </div>
              </div>

            </div>

            <!-- Social Links -->
            <div class="pt-6 border-t border-white/10">
              <span class="text-xs uppercase text-slate-400 font-bold block mb-3">Connect with Us</span>
              <div class="flex flex-wrap items-center gap-2.5">
                
                <!-- 1. Twitter / X -->
                <a href="<%= academy.brand.socials.twitter %>" target="_blank" aria-label="Twitter" title="Twitter / X" class="w-10 h-10 rounded-xl bg-[#1DA1F2] flex items-center justify-center text-white shadow-md hover:scale-110 transition-all duration-300">
                  <svg class="w-4.5 h-4.5 fill-white" viewBox="0 0 24 24">
                    <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
                  </svg>
                </a>

                <!-- 2. Facebook -->
                <a href="<%= academy.brand.socials.facebook %>" target="_blank" aria-label="Facebook" title="Facebook" class="w-10 h-10 rounded-xl bg-[#4267B2] flex items-center justify-center text-white shadow-md hover:scale-110 transition-all duration-300">
                  <svg class="w-4.5 h-4.5 fill-white" viewBox="0 0 24 24">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                  </svg>
                </a>

                <!-- 3. Instagram -->
                <a href="<%= academy.brand.socials.instagram %>" target="_blank" aria-label="Instagram" title="Instagram" class="w-10 h-10 rounded-xl bg-black border border-white/20 flex items-center justify-center text-white shadow-md hover:scale-110 hover:border-amber-400 transition-all duration-300">
                  <svg class="w-4.5 h-4.5 stroke-white fill-none stroke-2" viewBox="0 0 24 24">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                </a>

                <!-- 4. WhatsApp -->
                <a href="https://wa.me/<%= academy.brand.whatsapp %>" target="_blank" aria-label="WhatsApp" title="WhatsApp Concierge" class="w-10 h-10 rounded-xl bg-[#25D366] flex items-center justify-center text-white shadow-md hover:scale-110 transition-all duration-300">
                  <svg class="w-4.5 h-4.5 fill-white" viewBox="0 0 24 24">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                  </svg>
                </a>

                <!-- 5. TikTok -->
                <a href="<%= academy.brand.socials.tiktok %>" target="_blank" aria-label="TikTok" title="TikTok (@www.ashen8)" class="w-10 h-10 rounded-xl bg-[#111319] border border-white/20 flex items-center justify-center text-white shadow-md hover:scale-110 hover:border-amber-400 transition-all duration-300">
                  <svg class="w-4.5 h-4.5 fill-current" viewBox="0 0 24 24">
                    <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.86 4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-.04-4.52z"/>
                  </svg>
                </a>

              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Main Booking Form (7 cols) -->
      <div class="lg:col-span-7">
        <div class="c-bezel border-amber-500/30">
          <div class="c-bezel-inner p-8 sm:p-10">
            <h2 class="text-2xl sm:text-3xl font-extrabold font-heading text-white mb-2">
              Reserve Your Priority Evaluation
            </h2>
            <p class="text-slate-400 text-xs sm:text-sm mb-6">
              Please provide details about your dog's current age, breed, and any challenges you are facing.
            </p>

            <form id="contact-booking-form" onsubmit="handleDirectBooking(event)" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Your Name *</label>
                  <input type="text" id="c-name" required placeholder="Full Name" class="w-full px-4 py-2.5 rounded-xl bg-black/60 border border-white/10 text-white text-sm focus:border-amber-500 focus:outline-none">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Phone / WhatsApp *</label>
                  <input type="tel" id="c-phone" required placeholder="07x xxx xxxx" class="w-full px-4 py-2.5 rounded-xl bg-black/60 border border-white/10 text-white text-sm focus:border-amber-500 focus:outline-none">
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Dog's Name *</label>
                  <input type="text" id="c-dog-name" required placeholder="Dog Name" class="w-full px-4 py-2.5 rounded-xl bg-black/60 border border-white/10 text-white text-sm focus:border-amber-500 focus:outline-none">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Breed *</label>
                  <input type="text" id="c-dog-breed" required placeholder="Breed" class="w-full px-4 py-2.5 rounded-xl bg-black/60 border border-white/10 text-white text-sm focus:border-amber-500 focus:outline-none">
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Age *</label>
                  <input type="text" id="c-dog-age" required placeholder="Age" class="w-full px-4 py-2.5 rounded-xl bg-black/60 border border-white/10 text-white text-sm focus:border-amber-500 focus:outline-none">
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Desired Program *</label>
                  <select id="c-program" required class="w-full px-4 py-2.5 rounded-xl bg-black/60 border border-white/10 text-white text-sm focus:border-amber-500 focus:outline-none">
                    <option value="">Select Program</option>
                    <% academy.programs.forEach(function(prog) { %>
                      <option value="<%= prog.title %>"><%= prog.title %></option>
                    <% }); %>
                    <option value="General Behavioral Advice">General Advice</option>
                  </select>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Your City / Location *</label>
                  <input type="text" id="c-location" required placeholder="e.g. Colombo 07, Kandy, Galle" class="w-full px-4 py-2.5 rounded-xl bg-black/60 border border-white/10 text-white text-sm focus:border-amber-500 focus:outline-none">
                </div>
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-300 uppercase mb-1">Specific Behavioral Notes</label>
                <textarea id="c-notes" rows="3" placeholder="Describe any behavioral challenges (leash pulling, reactivity, aggression, jumping, potty training)..." class="w-full px-4 py-2.5 rounded-xl bg-black/60 border border-white/10 text-white text-sm focus:border-amber-500 focus:outline-none"></textarea>
              </div>

              <div class="pt-2">
                <button type="submit" class="btn-primary-luxury w-full justify-center text-sm py-3">
                  <span>Submit & Connect to WhatsApp Concierge</span>
                  <div class="icon-disc">
                    <i data-lucide="arrow-right" class="w-4 h-4 text-black"></i>
                  </div>
                </button>
              </div>
            </form>

            <script>
              function handleDirectBooking(e) {
                e.preventDefault();
                const name = document.getElementById('c-name').value;
                const phone = document.getElementById('c-phone').value;
                const dogName = document.getElementById('c-dog-name').value;
                const breed = document.getElementById('c-dog-breed').value;
                const age = document.getElementById('c-dog-age').value;
                const prog = document.getElementById('c-program').value;
                const loc = document.getElementById('c-location').value;
                const notes = document.getElementById('c-notes').value;

                const text = `*CEYLON K9 ACADEMY BOOKING INQUIRY*%0A%0A` +
                  `👤 *Owner:* ${encodeURIComponent(name)}%0A` +
                  `📞 *Phone:* ${encodeURIComponent(phone)}%0A` +
                  `🐕 *Dog:* ${encodeURIComponent(dogName)} (${encodeURIComponent(breed)}, ${encodeURIComponent(age)})%0A` +
                  `🎯 *Program:* ${encodeURIComponent(prog)}%0A` +
                  `📍 *Location:* ${encodeURIComponent(loc)}%0A` +
                  `📝 *Notes:* ${encodeURIComponent(notes || 'None')}`;

                window.open(`https://wa.me/<%= academy.brand.whatsapp %>?text=${text}`, '_blank');
              }
            </script>

          </div>
        </div>
      </div>

    </div>
  </section>

</main>

<%- include('partials/footer') %>
